{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "description": "Pulse — Personal Global Intelligence Feed. Serverless-first news intelligence dashboard.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
