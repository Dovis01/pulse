# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Pulse
NEXT_PUBLIC_SITE_TAGLINE=Global Intelligence Feed
APP_TIMEZONE=Asia/Tokyo

# ── Database (Supabase Postgres recommended; provider-agnostic) ────
# When absent, Pulse runs in demo mode with an in-memory seeded store.
DATABASE_URL=

# Optional Supabase client keys (only needed for Supabase Auth later)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (free-tier first; Gemini default) ────────────────────────────
AI_ENABLED=true
AI_PROVIDER=gemini
AI_MODEL=
GEMINI_API_KEY=

# ── Source tokens (all optional; anonymous mode works) ──────────────
GITHUB_TOKEN=
HF_TOKEN=

# ── Cron security ───────────────────────────────────────────────────
CRON_SECRET=

# ── Telegram (primary realtime alert channel) ───────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Email digest (Resend) ───────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# ── Single-user auth (optional) ─────────────────────────────────────
AUTH_SECRET=
ALLOWED_EMAIL=

# ── Cost guards (never enable billing automatically) ────────────────
ALLOW_PAID_PROVIDERS=false
ALLOW_PAID_AI=false

# ── Optional paid news API (disabled by default) ────────────────────
NEWS_API_KEY=
